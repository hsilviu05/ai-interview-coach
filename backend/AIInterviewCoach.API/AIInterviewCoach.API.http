@baseUrl = http://localhost:5291/api

### Register a new user
# @name registerCandidate
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Silviu Hermeneanu",
  "email": "silviu@test.com",
  "password": "Password123!",
  "role": "Candidate"
}

### Register a new user
# @name registerInterviewer
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "fullName": "Interviewer",
  "email": "interviewer@test.com",
  "password": "Password123!",
  "role": "Interviewer"
}

### Login
# @name loginInterviewer
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "interviewer@test.com",
  "password": "Password123!"
}

### Token variable from login response
@token = {{loginInterviewer.response.body.token}}

### Get current user (requires auth)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Create problem (Interviewer only)
# @name createProblem
POST {{baseUrl}}/problems
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Two Sum",
  "description": "Find two numbers that add up to target",
  "difficulty": "Easy",
  "topic": "Arrays",
  "constraintsText": "2 <= nums.length <= 10000",
  "exampleInput": "[2,7,11,15], 9",
  "exampleOutput": "[0,1]",
  "isPublic": true
}

###
@problemId = {{createProblem.response.body.id}}

### Get all problems
GET {{baseUrl}}/problems
Authorization: Bearer {{token}}

### Add test case
POST {{baseUrl}}/problems/{{problemId}}/testcases
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "input": "[2,7,11,15], 9",
  "expectedOutput": "[0,1]",
  "isHidden": false,
  "orderIndex": 1
}

### Get test cases
GET {{baseUrl}}/problems/{{problemId}}/testcases
Authorization: Bearer {{token}}

### Create interview
# @name createInterview
POST {{baseUrl}}/interviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Junior Backend Interview",
  "positionName": "Junior Backend Developer",
  "description": "Basic backend interview",
  "durationMinutes": 60
}

###
@interviewId = {{createInterview.response.body.id}}
@interviewToken = {{createInterview.response.body.accessToken}}

### Login candidate
# @name loginCandidate
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "silviu@test.com",
  "password": "Password123!"
}
###
@candidateToken = {{loginCandidate.response.body.token}}

### Add problem to interview
POST {{baseUrl}}/interviews/{{interviewId}}/problems
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "problemId": "{{problemId}}",
  "orderIndex": 1,
  "points": 100
}

### Get interview by id
GET {{baseUrl}}/interviews/{{interviewId}}
Authorization: Bearer {{token}}

### Get interview by token
GET {{baseUrl}}/interviews/token/{{interviewToken}}
Authorization: Bearer {{token}}

### Start interview session
# @name startInterview
POST {{baseUrl}}/interviews/token/{{interviewToken}}/start
Authorization: Bearer {{candidateToken}}

###
@interviewSessionId = {{startInterview.response.body.id}}

### Create submission
POST {{baseUrl}}/submissions
Authorization: Bearer {{candidateToken}}
Content-Type: application/json

{
  "problemId": "{{problemId}}",
  "interviewSessionId": "{{interviewSessionId}}",
  "language": "csharp",
  "sourceCode": "public class Solution { }"
}

### Get my submissions
GET {{baseUrl}}/submissions/me
Authorization: Bearer {{candidateToken}}

### Get submissions by session
GET {{baseUrl}}/submissions/session/{{interviewSessionId}}
Authorization: Bearer {{candidateToken}}

### Complete interview session
POST {{baseUrl}}/interviews/sessions/{{interviewSessionId}}/complete
Authorization: Bearer {{candidateToken}}